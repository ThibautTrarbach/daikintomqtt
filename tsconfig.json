{
    "compilerOptions": {
        /* Target & modules */
        "target": "ES2022",
        "module": "commonjs",
        "moduleResolution": "node",
        "rootDir": "./src",
        "outDir": "./dist",

        /* Experimental features */
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,

        /* JavaScript support (project full TS) */
        "allowJs": false,
        "checkJs": false,

        /* Emit */
        "declaration": true,
        "declarationMap": false,
        "sourceMap": true,
        "removeComments": true,
        "noEmitOnError": true,
        "incremental": true,

        /* Interop & platform */
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,

        /* Type Checking */
        "strict": true,
        "skipLibCheck": true,
        "noImplicitAny": false
    }
}
