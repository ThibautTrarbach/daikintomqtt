{
  "name": "daikin2mqtt",
  "version": "2.1.9",
  "description": "",
  "main": "daikinToMQTT.js",
  "scripts": {
    "run": "ts-node ./src/main.ts",
    "clean": "tsc --build --clean",
    "start": "node --preserve-symlinks dist/main.js",
    "buildStart": "tsc --build && node -e \"require('fs').cpSync('src/daikin-cloud/cert','dist/daikin-cloud/cert',{recursive:true})\" && node --preserve-symlinks dist/main.js",
    "build": "tsc --build && node -e \"require('fs').cpSync('src/daikin-cloud/cert','dist/daikin-cloud/cert',{recursive:true})\"",
    "fetch-daikin-docs": "node scripts/fetch-daikin-docs.mjs",
    "schema:check": "ts-node scripts/schema-check.ts",
    "test:oauth": "ts-node test/integration/oauth-developer-portal.test.ts && ts-node test/integration/oauth-mobile-app.test.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cache-manager": "^7.2.9",
    "ip": "^2.0.1",
    "js-yaml": "^5.4.3",
    "mqtt": "^5.16.0",
    "node-cron": "^4.6.0",
    "openid-client": "^5.7.1",
    "ts-morph": "^28.0.0",
    "uuid": "^14.0.3",
    "winston": "^3.19.0",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/ip": "^1.1.3",
    "@types/node": "^22.20.5",
    "@types/node-cron": "^3.0.11",
    "@types/validator": "^13.15.10",
    "@types/ws": "^8.18.2",
    "playwright": "^1.64.0",
    "reflect-metadata": "^0.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
